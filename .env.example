# Copy to .env and adjust as needed. All values are optional.

# --- Models ---
EMBEDDING_MODEL=all-MiniLM-L6-v2
OLLAMA_MODEL=llama3.2

# Leave blank to use the client default (http://localhost:11434).
# In Docker, point this at the host: http://host.docker.internal:11434
OLLAMA_HOST=

# --- Chunking ---
CHUNK_SIZE=1000
CHUNK_OVERLAP=200

# --- Retrieval ---
TOP_K=3

# --- Generation ---
LLM_TEMPERATURE=0.3
LLM_MAX_TOKENS=512
LLM_TIMEOUT_SECONDS=120

# --- Storage and limits ---
INDEX_DIR=
MAX_UPLOAD_MB=25

# --- Logging ---
LOG_LEVEL=INFO
